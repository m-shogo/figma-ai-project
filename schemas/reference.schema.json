{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/figma-ai-project/reference.schema.json",
  "title": "Figma AI Reference Manifest",
  "type": "object",
  "required": ["schema_version", "reference_id", "status", "figma", "frames", "responsive", "code_baseline", "freeze"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "reference_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["WAITING_FOR_REFERENCE", "DRAFT", "REFERENCE_READY", "SUPERSEDED"] },
    "figma": {
      "type": "object",
      "required": ["file_url", "file_key", "node_ids", "captured_at"],
      "properties": {
        "file_url": { "type": "string" },
        "file_key": { "type": "string" },
        "node_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "branch_or_version": { "type": "string" },
        "captured_at": { "type": "string" },
        "environment": { "type": "object" }
      },
      "additionalProperties": true
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "node_id", "figma_width", "acceptance_viewport"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "node_id": { "type": "string" },
          "figma_width": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "figma_height": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "acceptance_viewport": {
            "type": "object",
            "required": ["width", "height"],
            "properties": {
              "width": { "type": ["integer", "null"], "exclusiveMinimum": 0 },
              "height": { "type": ["integer", "null"], "exclusiveMinimum": 0 }
            },
            "additionalProperties": true
          },
          "screenshot": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "states": { "type": "array" },
    "structure": { "type": "object" },
    "assets": { "type": "array" },
    "responsive": {
      "type": "object",
      "required": ["breakpoint_evidence", "invariants", "transitions", "ordering_rules", "visibility_rules", "wrapping_rules", "container_rules", "unknowns"],
      "properties": {
        "breakpoint_evidence": {
          "type": "object",
          "required": ["source", "source_refs", "values", "notes"],
          "properties": {
            "source": { "enum": ["OWNER", "COMPANY", "DESIGN_SYSTEM", "EXISTING_CODE", "FIGMA", "MULTIPLE", "UNKNOWN"] },
            "source_refs": { "type": "array", "items": { "type": "string" } },
            "values": { "type": "array" },
            "notes": { "type": "array" }
          },
          "additionalProperties": true
        },
        "invariants": { "type": "array" },
        "transitions": { "type": "array" },
        "ordering_rules": { "type": "array" },
        "visibility_rules": { "type": "array" },
        "wrapping_rules": { "type": "array" },
        "container_rules": { "type": "array" },
        "unknowns": { "type": "array" }
      },
      "additionalProperties": true
    },
    "owner_notes": { "type": "array" },
    "material_unknowns": { "type": "array" },
    "code_baseline": {
      "type": "object",
      "required": ["repository", "base_branch", "starting_commit", "target_route", "framework"],
      "properties": {
        "repository": { "type": "string" },
        "base_branch": { "type": "string" },
        "starting_commit": { "type": "string" },
        "target_route": { "type": "string" },
        "framework": { "type": "string" },
        "package_manager": { "type": "string" },
        "design_system_paths": { "type": "array", "items": { "type": "string" } },
        "token_paths": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "freeze": {
      "type": "object",
      "required": ["ready", "frozen_at"],
      "properties": {
        "ready": { "type": "boolean" },
        "frozen_at": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
