{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/figma-ai-project/run.schema.json",
  "title": "Figma AI Run Record",
  "type": "object",
  "required": ["schema_version", "experiment_id", "run_id", "run_class", "status", "tooling_preflight", "reference", "coordination", "agent", "code", "context", "execution", "captures", "scores", "rework", "failures", "repairs", "replay", "lessons"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "experiment_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "run_class": { "enum": ["COMMON", "OPTIMIZED", "REPLAY"] },
    "status": { "enum": ["PLANNED", "RUNNING", "BLOCKED", "COMPLETE", "INVALID"] },
    "started_at": { "type": "string" },
    "completed_at": { "type": "string" },
    "tooling_preflight": {
      "type": "object",
      "required": ["checked_at", "figma_release_notes_checked", "figma_mcp_docs_checked", "agent_docs_checked", "community_scan_checked", "changes_relevant_to_run", "rules_to_retest", "new_hypotheses", "blockers_or_limits"],
      "properties": {
        "checked_at": { "type": "string" },
        "figma_release_notes_checked": { "type": "boolean" },
        "figma_mcp_docs_checked": { "type": "boolean" },
        "agent_docs_checked": { "type": "boolean" },
        "community_scan_checked": { "type": "boolean" },
        "changes_relevant_to_run": { "type": "array" },
        "rules_to_retest": { "type": "array" },
        "new_hypotheses": { "type": "array" },
        "blockers_or_limits": { "type": "array" }
      },
      "additionalProperties": true
    },
    "reference": {
      "type": "object",
      "required": ["reference_id", "manifest_path", "manifest_sha256", "figma_nodes"],
      "properties": {
        "reference_id": { "type": "string", "minLength": 1 },
        "manifest_path": { "type": "string" },
        "manifest_sha256": { "type": "string" },
        "figma_nodes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "coordination": {
      "type": "object",
      "required": [
        "scope",
        "section_id",
        "parallel_group",
        "shared_contract_path",
        "shared_contract_sha256",
        "section_manifest_path",
        "section_manifest_sha256",
        "figma_structure_profile_path",
        "figma_structure_profile_sha256",
        "foundation_commit",
        "isolation_mode",
        "isolation_ref"
      ],
      "properties": {
        "scope": { "enum": ["SECTION", "INTEGRATION", "PAGE_BENCHMARK"] },
        "section_id": { "type": "string" },
        "parallel_group": { "type": "string" },
        "company_policy_path": { "type": "string" },
        "company_policy_id": { "type": "string" },
        "company_policy_sha256": { "type": "string" },
        "shared_contract_path": { "type": "string" },
        "shared_contract_sha256": { "type": "string" },
        "section_manifest_path": { "type": "string" },
        "section_manifest_sha256": { "type": "string" },
        "figma_structure_profile_path": { "type": "string" },
        "figma_structure_profile_sha256": { "type": "string" },
        "required_environment_profiles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "canonical_environment_profile": { "type": "string" },
        "foundation_commit": { "type": "string" },
        "isolation_mode": { "enum": ["", "BRANCH_WORKTREE", "AGENT_SANDBOX", "SERIAL_SHARED_TREE", "OTHER"] },
        "isolation_ref": { "type": "string" }
      },
      "additionalProperties": true
    },
    "agent": {
      "type": "object",
      "required": ["client", "model", "instruction_sources", "mcp_mode"],
      "properties": {
        "client": { "type": "string" },
        "model": { "type": "string" },
        "model_alias": { "type": "string" },
        "client_version": { "type": "string" },
        "instruction_sources": { "type": "array", "items": { "type": "string" } },
        "mcp_mode": { "type": "string" },
        "mcp_notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "code": {
      "type": "object",
      "required": ["repository", "starting_commit", "target_route", "first_pass_commit", "final_commit"],
      "properties": {
        "repository": { "type": "string" },
        "starting_commit": { "type": "string" },
        "target_route": { "type": "string" },
        "first_pass_commit": { "type": "string" },
        "final_commit": { "type": "string" }
      },
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "required": ["tier", "prompt_version", "prompt_hash", "code_connect", "files_read", "figma_nodes_inspected"],
      "properties": {
        "tier": { "enum": ["C0", "C1", "C2", "C3", "C4"] },
        "prompt_version": { "type": "string" },
        "prompt_hash": { "type": "string" },
        "figma_design_context": { "type": "boolean" },
        "figma_metadata": { "type": "boolean" },
        "figma_screenshots": { "type": "boolean" },
        "figma_components": { "type": "boolean" },
        "figma_variables": { "type": "boolean" },
        "figma_annotations": { "type": "boolean" },
        "code_connect": { "type": "boolean" },
        "files_read": { "type": "array", "items": { "type": "string" } },
        "figma_nodes_inspected": { "type": "array", "items": { "type": "string" } },
        "tool_calls": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "required": ["workflow", "max_repair_rounds", "actual_repair_rounds", "assumptions", "blockers", "human_intervention"],
      "properties": {
        "workflow": { "enum": ["STAGED", "ONE_SHOT"] },
        "max_repair_rounds": { "type": "integer", "minimum": 0 },
        "actual_repair_rounds": { "type": "integer", "minimum": 0 },
        "assumptions": { "type": "array" },
        "blockers": { "type": "array" },
        "human_intervention": { "type": "string" }
      },
      "additionalProperties": true
    },
    "captures": {
      "type": "object",
      "required": ["first_pass", "verify", "final"],
      "properties": {
        "first_pass": { "type": "array", "items": { "$ref": "#/$defs/capture" } },
        "verify": { "type": "array", "items": { "$ref": "#/$defs/capture" } },
        "final": { "type": "array", "items": { "$ref": "#/$defs/capture" } }
      },
      "additionalProperties": true
    },
    "scores": {
      "type": "object",
      "required": ["first_pass_fidelity", "final_fidelity", "rework_efficiency", "reproducibility", "final_composite"],
      "properties": {
        "first_pass_fidelity": { "$ref": "#/$defs/fidelity" },
        "final_fidelity": { "$ref": "#/$defs/fidelity" },
        "rework_efficiency": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "reproducibility": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "final_composite": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": true
    },
    "rework": {
      "type": "object",
      "required": ["repair_rounds", "rebuild_count", "integration_only_failures", "shared_contract_revisions", "foundation_rebuilds", "merge_conflicts", "affected_section_count", "contract_violations", "severity_counts"],
      "properties": {
        "repair_rounds": { "type": "integer", "minimum": 0 },
        "post_first_pass_files_changed": { "type": ["integer", "null"], "minimum": 0 },
        "post_first_pass_lines_added": { "type": ["integer", "null"], "minimum": 0 },
        "post_first_pass_lines_deleted": { "type": ["integer", "null"], "minimum": 0 },
        "rebuild_count": { "type": "integer", "minimum": 0 },
        "integration_only_failures": { "type": "integer", "minimum": 0 },
        "shared_contract_revisions": { "type": "integer", "minimum": 0 },
        "foundation_rebuilds": { "type": "integer", "minimum": 0 },
        "merge_conflicts": { "type": "integer", "minimum": 0 },
        "affected_section_count": { "type": "integer", "minimum": 0 },
        "contract_violations": { "type": "integer", "minimum": 0 },
        "severity_counts": {
          "type": "object",
          "required": ["S1", "S2", "S3", "S4"],
          "properties": {
            "S1": { "type": "integer", "minimum": 0 },
            "S2": { "type": "integer", "minimum": 0 },
            "S3": { "type": "integer", "minimum": 0 },
            "S4": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "failures": { "type": "array" },
    "repairs": { "type": "array" },
    "replay": {
      "type": "object",
      "required": ["required", "source_run", "result"],
      "properties": {
        "required": { "type": "boolean" },
        "source_run": { "type": "string" },
        "result": { "enum": ["NOT_RUN", "REPRODUCED", "NOT_REPRODUCED"] }
      },
      "additionalProperties": true
    },
    "lessons": {
      "type": "object",
      "required": ["observations", "candidate_rules", "agent_specific", "project_specific"],
      "properties": {
        "observations": { "type": "array" },
        "candidate_rules": { "type": "array" },
        "agent_specific": { "type": "array" },
        "project_specific": { "type": "array" }
      },
      "additionalProperties": true
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "capture": {
      "type": "object",
      "required": ["capture_id", "scope", "target_id", "frame_id", "environment_profile_id", "runtime", "input_state", "preferences", "path", "captured_at", "deterministic", "notes"],
      "properties": {
        "capture_id": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["SECTION", "BOUNDARY", "CLUSTER", "FULL_PAGE", "INTERACTION"] },
        "target_id": { "type": "string", "minLength": 1 },
        "frame_id": { "type": "string" },
        "environment_profile_id": { "type": "string", "minLength": 1 },
        "runtime": {
          "type": "object",
          "required": ["browser", "browser_version", "os", "os_version", "engine", "webview", "viewport_width_css_px", "viewport_height_css_px", "dpr", "zoom", "text_scale", "orientation"],
          "properties": {
            "browser": { "type": "string", "minLength": 1 },
            "browser_version": { "type": "string" },
            "os": { "type": "string", "minLength": 1 },
            "os_version": { "type": "string" },
            "engine": { "type": "string" },
            "webview": { "type": "boolean" },
            "viewport_width_css_px": { "type": "number", "exclusiveMinimum": 0 },
            "viewport_height_css_px": { "type": "number", "exclusiveMinimum": 0 },
            "dpr": { "type": "number", "exclusiveMinimum": 0 },
            "zoom": { "type": "number", "exclusiveMinimum": 0 },
            "text_scale": { "type": "number", "exclusiveMinimum": 0 },
            "orientation": { "enum": ["PORTRAIT", "LANDSCAPE", "SQUARE", "UNKNOWN"] }
          },
          "additionalProperties": true
        },
        "input_state": {
          "type": "object",
          "required": ["primary_hover", "primary_pointer", "touch"],
          "properties": {
            "primary_hover": { "enum": ["HOVER", "NONE", "UNKNOWN"] },
            "primary_pointer": { "enum": ["FINE", "COARSE", "NONE", "UNKNOWN"] },
            "touch": { "type": ["boolean", "null"] }
          },
          "additionalProperties": true
        },
        "preferences": {
          "type": "object",
          "required": ["reduced_motion", "forced_colors", "contrast", "color_scheme"],
          "properties": {
            "reduced_motion": { "enum": ["REDUCE", "NO_PREFERENCE", "UNKNOWN"] },
            "forced_colors": { "enum": ["ACTIVE", "NONE", "UNKNOWN"] },
            "contrast": { "enum": ["MORE", "LESS", "CUSTOM", "NO_PREFERENCE", "UNKNOWN"] },
            "color_scheme": { "enum": ["LIGHT", "DARK", "NO_PREFERENCE", "UNKNOWN"] }
          },
          "additionalProperties": true
        },
        "path": { "type": "string" },
        "captured_at": { "type": "string" },
        "deterministic": { "type": "boolean" },
        "notes": { "type": "array" }
      },
      "additionalProperties": true
    },
    "fidelity": {
      "type": "object",
      "required": ["visual", "structural", "robustness", "total"],
      "properties": {
        "visual": { "type": ["number", "null"], "minimum": 0, "maximum": 40 },
        "structural": { "type": ["number", "null"], "minimum": 0, "maximum": 25 },
        "robustness": { "type": ["number", "null"], "minimum": 0, "maximum": 15 },
        "total": { "type": ["number", "null"], "minimum": 0, "maximum": 80 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}