{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/figma-ai-project/section.schema.json",
  "title": "Figma AI Section Execution Manifest",
  "type": "object",
  "$defs": {
    "observationPresence": {
      "enum": ["PRESENT", "NONE", "UNDETERMINED"]
    },
    "runtimeReview": {
      "type": "object",
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "enum": ["PENDING", "PASS", "KNOWN_GAP", "NOT_APPLICABLE"]
        },
        "evidence": {
          "type": "array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "PASS"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evidence": {"minItems": 1}
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "sectionObservationCoverage": {
      "type": "object",
      "required": ["source_presence", "source_evidence", "runtime_review", "known_gaps"],
      "properties": {
        "source_presence": {
          "type": "object",
          "required": [
            "TEXT",
            "RASTER_MEDIA",
            "VECTOR_LOGO",
            "BACKGROUND",
            "DECORATION",
            "INTERACTION_STATE",
            "RESPONSIVE_VARIANT"
          ],
          "properties": {
            "TEXT": {"$ref": "#/$defs/observationPresence"},
            "RASTER_MEDIA": {"$ref": "#/$defs/observationPresence"},
            "VECTOR_LOGO": {"$ref": "#/$defs/observationPresence"},
            "BACKGROUND": {"$ref": "#/$defs/observationPresence"},
            "DECORATION": {"$ref": "#/$defs/observationPresence"},
            "INTERACTION_STATE": {"$ref": "#/$defs/observationPresence"},
            "RESPONSIVE_VARIANT": {"$ref": "#/$defs/observationPresence"}
          },
          "additionalProperties": false
        },
        "source_evidence": {
          "type": "array",
          "minItems": 1
        },
        "runtime_review": {
          "type": "object",
          "required": ["sp", "pc"],
          "properties": {
            "sp": {"$ref": "#/$defs/runtimeReview"},
            "pc": {"$ref": "#/$defs/runtimeReview"}
          },
          "additionalProperties": true
        },
        "known_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "reason"],
            "properties": {
              "category": {
                "enum": [
                  "TEXT",
                  "RASTER_MEDIA",
                  "VECTOR_LOGO",
                  "BACKGROUND",
                  "DECORATION",
                  "INTERACTION_STATE",
                  "RESPONSIVE_VARIANT",
                  "OTHER"
                ]
              },
              "reason": {"type": "string", "minLength": 1},
              "evidence": {"type": "array"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "integrationObservationCoverage": {
      "type": "object",
      "required": ["sp_full_page", "pc_full_page", "evidence", "known_gaps"],
      "properties": {
        "sp_full_page": {
          "enum": ["PENDING", "PASS", "KNOWN_GAP", "NOT_APPLICABLE"]
        },
        "pc_full_page": {
          "enum": ["PENDING", "PASS", "KNOWN_GAP", "NOT_APPLICABLE"]
        },
        "evidence": {"type": "array"},
        "known_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["section_id", "reason"],
            "properties": {
              "section_id": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1},
              "evidence": {"type": "array"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "required": ["schema_version", "reference_id", "page_id", "shared_contract", "shared_contract_sha256", "figma_structure_profile", "figma_structure_profile_sha256", "foundation_commit", "sections", "integration"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "reference_id": { "type": "string", "minLength": 1 },
    "page_id": { "type": "string" },
    "shared_contract": { "type": "string" },
    "shared_contract_sha256": { "type": "string" },
    "figma_structure_profile": { "type": "string" },
    "figma_structure_profile_sha256": { "type": "string" },
    "foundation_commit": { "type": "string" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section_id", "name", "order", "figma", "evidence", "dependencies", "responsive", "implementation", "worker"],
        "properties": {
          "section_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "order": { "type": "integer" },
          "figma": {
            "type": "object",
            "required": ["logical_role", "pc_node_id", "sp_node_id", "other_node_ids", "semantic_name_source", "boundary_source", "boundary_confidence", "boundary_evidence", "pc_sp_mapping_confidence", "mapping_evidence"],
            "properties": {
              "logical_role": { "type": "string" },
              "pc_node_id": { "type": "string" },
              "sp_node_id": { "type": "string" },
              "other_node_ids": { "type": "array", "items": { "type": "string" } },
              "semantic_name_source": { "enum": ["FIGMA", "AI_CANDIDATE", "OWNER"] },
              "boundary_source": { "enum": ["FIGMA_SECTION", "FIGMA_TOP_LEVEL", "SEMANTIC_STRUCTURE", "AI_CANDIDATE", "OWNER"] },
              "boundary_confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
              "boundary_evidence": { "type": "array" },
              "pc_sp_mapping_confidence": { "enum": ["HIGH", "MEDIUM", "LOW", "NOT_APPLICABLE"] },
              "mapping_evidence": { "type": "array" }
            },
            "additionalProperties": true
          },
          "evidence": {
            "type": "object",
            "required": ["screenshots", "metadata_capture"],
            "properties": {
              "screenshots": { "type": "array" },
              "metadata_capture": { "type": "string" }
            },
            "additionalProperties": true
          },
          "dependencies": {
            "type": "object",
            "required": ["section_ids", "shared_components", "tokens", "fonts", "assets", "integration_coupling", "coupling_notes"],
            "properties": {
              "section_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "shared_components": { "type": "array" },
              "tokens": { "type": "array" },
              "fonts": { "type": "array" },
              "assets": { "type": "array" },
              "integration_coupling": { "enum": ["LOW", "MEDIUM", "HIGH"] },
              "coupling_notes": { "type": "array" }
            },
            "additionalProperties": true
          },
          "responsive": {
            "type": "object",
            "required": ["uses_shared_breakpoints", "invariants", "transitions", "unknowns", "breakpoint_exception_proposals"],
            "properties": {
              "uses_shared_breakpoints": { "type": "boolean" },
              "invariants": { "type": "array" },
              "transitions": { "type": "array" },
              "unknowns": { "type": "array" },
              "breakpoint_exception_proposals": { "type": "array" }
            },
            "additionalProperties": true
          },
          "observation_coverage": {
            "$ref": "#/$defs/sectionObservationCoverage"
          },
          "implementation": {
            "type": "object",
            "required": ["component_path", "style_path", "allowed_paths", "shared_files_read_only"],
            "properties": {
              "component_path": { "type": "string" },
              "style_path": { "type": "string" },
              "allowed_paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "shared_files_read_only": { "type": "boolean" }
            },
            "additionalProperties": true
          },
          "worker": {
            "type": "object",
            "required": ["status", "parallel_group", "contract_sha256", "isolation", "agent", "model", "base_commit", "output_commit", "proposed_shared_changes"],
            "properties": {
              "status": { "enum": ["PLANNED", "READY", "RUNNING", "BLOCKED", "COMPLETE"] },
              "parallel_group": { "type": "string" },
              "contract_sha256": { "type": "string" },
              "isolation": {
                "type": "object",
                "required": ["mode", "ref", "parallel_safe", "notes"],
                "properties": {
                  "mode": { "enum": ["UNASSIGNED", "BRANCH_WORKTREE", "AGENT_SANDBOX", "SERIAL_SHARED_TREE", "OTHER"] },
                  "ref": { "type": "string" },
                  "parallel_safe": { "type": "boolean" },
                  "notes": { "type": "array" }
                },
                "additionalProperties": true
              },
              "agent": { "type": "string" },
              "model": { "type": "string" },
              "base_commit": { "type": "string" },
              "output_commit": { "type": "string" },
              "proposed_shared_changes": { "type": "array" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "integration": {
      "type": "object",
      "required": ["root_composition_path", "required_checks"],
      "properties": {
        "status": {"enum": ["PLANNED", "RUNNING", "COMPLETE"]},
        "root_composition_path": { "type": "string" },
        "required_checks": { "type": "array", "items": { "type": "string" } },
        "observation_coverage": {
          "$ref": "#/$defs/integrationObservationCoverage"
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"minimum": 9}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "sections": {
            "items": {
              "required": ["observation_coverage"],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "worker": {
                        "properties": {"status": {"const": "COMPLETE"}},
                        "required": ["status"]
                      }
                    },
                    "required": ["worker"]
                  },
                  "then": {
                    "properties": {
                      "observation_coverage": {
                        "properties": {
                          "runtime_review": {
                            "properties": {
                              "sp": {
                                "properties": {
                                  "status": {"enum": ["PASS", "NOT_APPLICABLE"]}
                                }
                              },
                              "pc": {
                                "properties": {
                                  "status": {"enum": ["PASS", "NOT_APPLICABLE"]}
                                }
                              }
                            }
                          },
                          "known_gaps": {"maxItems": 0}
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "worker": {
                        "properties": {"status": {"const": "COMPLETE"}},
                        "required": ["status"]
                      },
                      "figma": {
                        "properties": {"sp_node_id": {"minLength": 1}},
                        "required": ["sp_node_id"]
                      }
                    },
                    "required": ["worker", "figma"]
                  },
                  "then": {
                    "properties": {
                      "observation_coverage": {
                        "properties": {
                          "runtime_review": {
                            "properties": {
                              "sp": {
                                "properties": {"status": {"const": "PASS"}}
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "worker": {
                        "properties": {"status": {"const": "COMPLETE"}},
                        "required": ["status"]
                      },
                      "figma": {
                        "properties": {"pc_node_id": {"minLength": 1}},
                        "required": ["pc_node_id"]
                      }
                    },
                    "required": ["worker", "figma"]
                  },
                  "then": {
                    "properties": {
                      "observation_coverage": {
                        "properties": {
                          "runtime_review": {
                            "properties": {
                              "pc": {
                                "properties": {"status": {"const": "PASS"}}
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "integration": {
            "required": ["status", "observation_coverage"],
            "allOf": [
              {
                "if": {
                  "properties": {"status": {"const": "COMPLETE"}},
                  "required": ["status"]
                },
                "then": {
                  "properties": {
                    "observation_coverage": {
                      "properties": {
                        "sp_full_page": {"enum": ["PASS", "NOT_APPLICABLE"]},
                        "pc_full_page": {"enum": ["PASS", "NOT_APPLICABLE"]},
                        "evidence": {"minItems": 1},
                        "known_gaps": {"maxItems": 0}
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": true
}