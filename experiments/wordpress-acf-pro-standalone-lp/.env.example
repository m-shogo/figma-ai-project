# Local fixture overrides only. Copy to .env when you need custom values.
# This file is intentionally valid shell syntax because setup/QA source the local .env.
# Leave runtime identity/network values empty to keep automatic per-worktree isolation.
COMPOSE_PROJECT_NAME=
WP_PORT=
WP_URL=
WP_SITE_TITLE="Standalone LP Fixture"
WP_ADMIN_USER=fixture-admin
WP_ADMIN_PASSWORD=fixture-admin-change-me
WP_ADMIN_EMAIL=fixture@example.invalid
WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=wordpress-fixture
WP_DB_ROOT_PASSWORD=wordpress-fixture-root

# ACF PRO is licensed software. Never commit the plugin or a real license key.
# Preferred local FULL E2E path: put the real key only in your private .env.
# setup.sh uses it for official Composer authentication and defines ACF_PRO_LICENSE
# only inside the disposable WordPress runtime.
ACF_PRO_LICENSE_KEY=""

# Optional offline/local artifact overrides. These win over Composer resolution.
# Quote paths that contain spaces.
ACF_PRO_PLUGIN_ZIP=""
ACF_PRO_PLUGIN_DIR=""
