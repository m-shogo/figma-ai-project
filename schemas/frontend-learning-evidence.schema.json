{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/m-shogo/figma-ai-project/schemas/frontend-learning-evidence.schema.json",
  "title": "Frontend Learning Evidence Index",
  "type": "object",
  "required": ["schema_version", "policy", "records"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "policy": {
      "type": "object",
      "required": [
        "auto_promotion",
        "evidence_retention",
        "contradictions_are_preserved",
        "lifecycle_doc",
        "cross_reference_evidence_required_for_active"
      ],
      "properties": {
        "auto_promotion": {"type": "boolean", "const": false},
        "evidence_retention": {"type": "string", "const": "APPEND_OR_SUPERSEDE_WITH_TRACE"},
        "contradictions_are_preserved": {"type": "boolean", "const": true},
        "lifecycle_doc": {"type": "string", "const": "docs/frontend-visual-repair-learning-loop.md"},
        "cross_reference_evidence_required_for_active": {"type": "boolean", "const": true}
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/learningRecord"}
    }
  },
  "$defs": {
    "learningRecord": {
      "type": "object",
      "required": [
        "learning_id",
        "summary",
        "category",
        "applicability",
        "promotion_state",
        "promotion",
        "evidence",
        "notes"
      ],
      "properties": {
        "learning_id": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "category": {
          "enum": [
            "VISUAL_FIDELITY",
            "OBSERVATION_COVERAGE",
            "RESPONSIVE",
            "MAINTAINABILITY",
            "REUSE",
            "FIGMA_PROVENANCE",
            "ASSET_STRATEGY",
            "CMS",
            "RUNTIME",
            "TOOLING",
            "OTHER"
          ]
        },
        "applicability": {
          "type": "object",
          "required": ["scope", "conditions", "exclusions"],
          "properties": {
            "scope": {"enum": ["REFERENCE", "PROJECT", "CROSS_REFERENCE", "EXTERNAL"]},
            "conditions": {"type": "array", "items": {"type": "string"}},
            "exclusions": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "promotion_state": {
          "enum": [null, "CORE", "ACTIVE", "CANDIDATE", "PROJECT_ONLY", "DEPRECATED", "RETIRED"]
        },
        "promotion": {
          "type": "object",
          "required": ["candidate", "rationale", "blocked_by", "contradiction_review"],
          "properties": {
            "candidate": {"type": "boolean"},
            "rationale": {"type": "string"},
            "blocked_by": {"type": "array", "items": {"type": "string"}},
            "contradiction_review": {"type": "string"}
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "object",
          "required": ["supports", "contradicts"],
          "properties": {
            "supports": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
            "contradicts": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}}
          },
          "additionalProperties": false
        },
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "evidenceItem": {
      "type": "object",
      "required": ["evidence_id", "kind", "reference_id", "run_id", "path", "commit", "note"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": ["LOCAL_RESEARCH", "RUN_RECORD", "COMMIT", "CANONICAL_DOC", "EXTERNAL_GUIDANCE"]
        },
        "reference_id": {"type": "string"},
        "run_id": {"type": "string"},
        "path": {"type": "string"},
        "commit": {"type": "string"},
        "source_field": {
          "enum": [
            "lessons.candidate_rules",
            "lessons.confirmed_rules",
            "lessons.contradicted_rules",
            "lessons.rules_needing_retest",
            "lessons.promotion_candidates",
            "lessons.demotion_candidates"
          ]
        },
        "source_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "note": {"type": "string", "minLength": 1}
      },
      "dependentRequired": {
        "source_field": ["source_text_sha256"],
        "source_text_sha256": ["source_field"]
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
