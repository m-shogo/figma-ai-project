{
  "manifest_version": 3,
  "name": "Figma Chat Continuation — Experimental",
  "version": "0.2.3",
  "description": "指定した既存チャットへFigma選択付き指示を送信。既定は停止。外部通信・回答本文の収集なし。",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
